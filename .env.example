# ============================================================================
# Nexus — production environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================================

# --- HTTP -------------------------------------------------------------------
PORT=8080

# --- Gateway credentials ----------------------------------------------------
# Comma separated: <apiKey>:<userID>:<requestsPerMinute>[:model1|model2]
# The optional 4th field is a model whitelist; empty = all configured models.
# Generate with: openssl rand -hex 24
GATEWAY_API_KEYS=sk-local-change-me:1:600:gpt-4o|claude-3-5-sonnet-20241022

# --- Upstream providers -----------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o,gpt-4o-mini
OPENAI_PRICE_PER_1M=10
OPENAI_CHANNEL_WEIGHT=10
OPENAI_CHANNEL_RATE=600

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MODELS=claude-3-5-sonnet-20241022
ANTHROPIC_PRICE_PER_1M=15
ANTHROPIC_CHANNEL_WEIGHT=5
ANTHROPIC_CHANNEL_RATE=300

# --- Local models (Ollama) --------------------------------------------------
# Set OLLAMA_MODELS to enable the local adapter. Private endpoints need
# OUTBOUND_ALLOW_PRIVATE=true, otherwise a direct client is used for this
# operator-configured URL only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=
OLLAMA_PRICE_PER_1M=0
OLLAMA_CHANNEL_WEIGHT=5
OLLAMA_CHANNEL_RATE=300

# --- Persistence ------------------------------------------------------------
# DB_DSN enables the PostgreSQL ledger. If it is set and unreachable, the
# gateway exits at startup instead of silently falling back to memory.
# Leave empty to run with the in-memory ledger (tests / single-node demo).
DB_DSN=postgres://gateway:gateway@postgres:5432/gateway?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
# price_versions is refreshed on this interval (seconds); 0 disables.
PRICE_REFRESH_SECONDS=30
REDIS_DSN=redis://redis:6379/0
REDIS_POOL_SIZE=64

# --- Admin / RBAC -----------------------------------------------------------
# key:tenantID:role  (role: owner|admin|member|viewer)
ADMIN_API_KEYS=admin-local-change-me:1:owner

# --- Killer features --------------------------------------------------------
# Deterministic prompt compression (whitespace/punctuation only, code blocks
# untouched). Saves 10-25% tokens on verbose prompts.
PROMPT_COMPRESSION=true

# Embedding-backed semantic cache (any OpenAI-compatible /embeddings endpoint).
# Leave EMBEDDING_API_URL empty to keep the cache exact-only.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=0
SEMANTIC_THRESHOLD=0.93

# --- Request budgets --------------------------------------------------------
# No global http.Client timeout exists (it would sever SSE). Every request is
# bounded by these values instead.
REQUEST_TIMEOUT_SECONDS=120
STREAM_TIMEOUT_SECONDS=300

# --- Audit ------------------------------------------------------------------
# Async batch writer into request_logs. A full buffer drops records and
# increments gateway_audit_dropped (never blocks the request path).
AUDIT_BUFFER=8192
AUDIT_BATCH=200

# --- Rate limiting ----------------------------------------------------------
GLOBAL_RATE_LIMIT=10000
IP_RATE_LIMIT=600
MODEL_RATE_LIMIT=300
# Optional CIDR allowlist; empty = allow all IPs (still rate limited)
IP_WHITELIST=
TRUST_PROXY=false

# --- Outbound SSRF policy ---------------------------------------------------
# Hosts the gateway may call. Keep this tight.
OUTBOUND_ALLOWLIST=api.openai.com,api.anthropic.com
OUTBOUND_PORTS=443
# Set true ONLY for self-hosted upstreams on private networks (vLLM/Ollama).
OUTBOUND_ALLOW_PRIVATE=false

# --- Billing ----------------------------------------------------------------
INITIAL_BALANCE=1000
